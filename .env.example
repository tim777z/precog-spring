# Copy to .env and adjust:  cp .env.example .env
#
# .env is git-ignored. Never commit a populated .env, and never put a credential in this
# file -- compose reads it verbatim and it ends up in the container's environment, where it
# is visible to anything that can read /proc or a `docker inspect` dump.
#
# Every value below is optional; the defaults in parentheses are what the service uses when
# the variable is absent.

# Greeting message, externalised exactly as the OpenShift ConfigMap does it. Spring Boot
# relaxed binding maps this onto the greeting.message property.
#
# Rules, enforced at start-up so a typo is a failed boot rather than a runtime 500:
#   - exactly one %s placeholder, which is replaced with the caller's name
#   - no other percent signs; a % must be omitted
#   - at most 512 characters
#   - the name itself is limited to 64 characters from letters, marks, digits, spaces and
#     . , ' - _
GREETING_MESSAGE=Hello, %s!

# Host interface the published port binds to. Keep 127.0.0.1 for local work; set 0.0.0.0 only
# behind an authenticating reverse proxy or an authenticated ingress.
BIND_ADDRESS=127.0.0.1

# Optional Spring profile (for example prod). Empty means no extra profile.
SPRING_PROFILES_ACTIVE=
